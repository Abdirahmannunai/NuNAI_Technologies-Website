# NuNAI Technologies – environment variables
# Copy to .env and fill in real values. Never commit .env to version control.

# Contact form backend (Formspree, EmailJS, or custom API endpoint)
VITE_CONTACT_FORM_ENDPOINT=

# Newsletter API endpoint
VITE_NEWSLETTER_ENDPOINT=

# WhatsApp number (digits only, with country code)
VITE_WHATSAPP_NUMBER=254000000000

# Google Analytics Measurement ID (optional)
VITE_GA_MEASUREMENT_ID=
